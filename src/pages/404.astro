---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title={i18n(I18nKey.notFound)} description={i18n(I18nKey.notFoundDescription)}>
  <script>
    import('../scripts/right-sidebar-layout.js');
  </script>
  <div class="card-base z-10 px-6 py-8 md:px-9 md:py-10 relative w-full">
    <p class="log-kicker">404 / {i18n(I18nKey.notFound)}</p>
    <h1 class="text-2xl font-bold mb-3 text-black/90 dark:text-white/90">
      {i18n(I18nKey.notFoundTitle)}
    </h1>
    <p class="text-75 mb-6 max-w-md leading-relaxed">
      {i18n(I18nKey.notFoundDescription)}
    </p>
    <a href={url("/")} class="btn-regular inline-flex items-center h-10 px-4 rounded-(--radius-large) font-medium">
      {i18n(I18nKey.backToHome)}
    </a>
  </div>
</MainGridLayout>
